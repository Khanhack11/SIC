  "cards": [
    {
      "dot": "cyan",
      "title": "Crop và resize khác nhau",
      "items": [
        "Crop lấy vùng lá do bạn chọn và bỏ phần ngoài khung. Resize đưa ảnh về kích thước model yêu cầu. Crop tốt vẫn cần giữ đủ vết tổn thương.",
        "V2 resize trực tiếp về 224 × 224 nên có thể đổi tỷ lệ hình. V3 giữ tỷ lệ, thêm viền xám để đủ 224 × 224 (letterbox), sau đó chuẩn hóa RGB."
      ]
    },
    {
      "dot": "violet",
      "title": "CNN không đọc tên bệnh từ ảnh",
      "items": [
        "Các lớp tích chập học bộ lọc từ dữ liệu, tạo tín hiệu về màu, đường nét và hoa văn. Pooling gom tín hiệu thành vector, đầu phân loại tạo một điểm thô cho mỗi lớp.",
        "V3 có đầu 960 → 256 → 12. Lớp thứ 12 là Unsupported. Model là bộ phân loại ảnh, chưa khoanh vị trí vết bệnh hay nhận ra mọi loại sâu hại."
      ]
    },
    {
      "dot": "amber",
      "title": "Vì sao có thể sai với điểm rất cao?",
      "items": [
        "Softmax biến logits/T thành các điểm có tổng bằng 1. Ví dụ 0,99 chỉ nói model nghiêng mạnh về một lựa chọn trong các lớp được học.",
        "Nền ảnh, ánh sáng hoặc tổn thương ngoài bộ nhãn có thể làm model chọn sai với điểm cao. Khi tải ảnh lên, trọng số giữ nguyên; đây không phải một lần train mới."
      ]
    }
  ]
