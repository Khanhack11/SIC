  "cards": [
    {
      "dot": "cyan",
      "title": "Tải về và kiểm tra",
      "items": [
        "Script tải ảnh từ GitHub tại revision cố định, kiểm tra hash rồi lưu ở data/raw. records.json lưu đường dẫn, nhãn, hash và split; không chứa trọng số model.",
        "Loại nhãn ngô blight mơ hồ, ảnh hỏng và nhóm trùng có nhãn xung đột. Một ảnh đại diện cho mỗi nhóm trùng PlantDoc; đây chưa phải chứng nhận tách riêng từng lá vật lý."
      ]
    },
    {
      "dot": "emerald",
      "title": "Model học như thế nào?",
      "items": [
        "V3 bắt đầu từ trọng số ImageNet. Đầu tiên giữ cố định CNN để học đầu phân loại, sau đó mở ba khối cuối để fine-tune trên GPU.",
        "Ảnh train được lật, xoay nhẹ và đổi sáng/màu. Loss đo độ lệch với nhãn; backprop tính hướng sửa trọng số, AdamW thực hiện cập nhật."
      ]
    },
    {
      "dot": "amber",
      "title": "Ba phần dữ liệu có vai trò khác nhau",
      "items": [
        "Train cập nhật trọng số. Validation chọn checkpoint và hiệu chỉnh một số T cho softmax; không dùng gradient validation để sửa CNN.",
        "Test chỉ đo sau khi chốt model. Báo cáo tách PlantVillage và PlantDoc vì ảnh chụp có kiểm soát và ảnh thực địa có mức khó khác nhau."
      ]
    }
  ]
