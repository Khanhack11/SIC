  "cards": [
    {
      "dot": "cyan",
      "title": "Điện thoại gọi máy chủ",
      "items": [
        "Trình duyệt chụp hoặc chọn JPG/PNG, có thể crop trước khi gửi. Model chạy trên máy chủ, không chạy trực tiếp trong điện thoại.",
        "Crop là hình chữ nhật do người dùng chọn. Hệ thống chưa có model tự phát hiện hoặc phân đoạn lá."
      ]
    },
    {
      "dot": "emerald",
      "title": "Hai model là hai lựa chọn",
      "items": [
        "MobileNetV2 là đường mặc định. MobileNetV3 chỉ được nạp khi đặt SIC_FIELD_MODEL_PATH; mỗi yêu cầu chạy một model.",
        "V3 được huấn luyện thêm với PlantDoc và có lớp Unsupported. Chưa có bảo đảm nhận ra mọi ảnh ngoài phạm vi."
      ]
    },
    {
      "dot": "amber",
      "title": "Điểm cao vẫn cần đối chiếu",
      "items": [
        "Ảnh thực địa bị dự đoán khỏe luôn cần xem lại. Nếu đánh dấu lá có tổn thương, kết quả khỏe bị chặn kết luận.",
        "Điểm softmax không phải độ chính xác trên ảnh này. Tri thức chăm sóc được tra từ JSON, không phải nội dung model tự viết."
      ]
    }
  ]
